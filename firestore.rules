rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ CONTENU PÉDAGOGIQUE ============
    // Lecture libre (cache offline), écriture admin uniquement.
    match /cours/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /exercices/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ PROFILS ============
    // 🔒 SÉCURITÉ (durcie) : autrefois `read: if true` exposait email/hash/code
    // de transfert à tout élève (écran classement). Le classement lit
    // désormais `classement_public` (champs sûrs, agrégés par Cloud Function).
    // La lecture du profil complet est donc réservée au propriétaire + admin.
    match /utilisateurs/{userId} {
      allow read: if estSoiMeme(userId) || isAdmin();
      allow create, update: if estSoiMeme(userId) && donneesUtilisateurPropres() && profilScolaireValide();
      allow delete: if isAdmin();
    }

    // ============ DONNÉES PRIVÉES (hash mdp, secrets) ============
    // Lisible/inscriptible UNIQUEMENT par le propriétaire (et l'admin).
    match /donnees_privees/{userId} {
      allow read, write: if estSoiMeme(userId) || isAdmin();
    }

    // ============ PROGRESSION PERSONNELLE ============
    match /progression/{userId} {
      allow read, write: if estSoiMeme(userId) || isAdmin();
    }

    // ============ RÉVISIONS PERSONNELLES ============
    match /revisions/{docId} {
      allow read, update, delete: if estSoiMeme(resource.data.userId);
      allow create: if estSoiMeme(request.resource.data.userId);
    }

    // ============ JOURNAL DE RÉVISIONS GAMIFIÉ ============
    match /revisions_log/{docId} {
      allow create: if estSoiMeme(request.resource.data.userId)
        && request.resource.data.xpGagne is number
        && request.resource.data.xpGagne >= 0 && request.resource.data.xpGagne <= 50;
      allow read: if estSoiMeme(resource.data.userId) || isAdmin();
    }

    // ============ SIGNALEMENTS (élève → admin) ============
    match /signalements/{docId} {
      // 🛡️ DURCISSEMENT 2026-10-02 : `create` était OUVERT AU MONDE (aucun
      // `estAuth()`). Un simple POST REST anonyme, sans compte, remplissait la
      // collection et faisait grossir le dashboard admin (spam + coût Spark).
      // Désormais : compte obligatoire + forme FERMÉE (hasOnly) + propriété du
      // signalement. `userId == null` reste accepté : la file hors-ligne peut
      // contenir un signalement déposé en mode invité, envoyé après connexion.
      allow create: if estAuth() && signalementValide();
      allow read: if isAdmin();
      // 🛠️ L'admin traite un signalement (marqué « ✔ Traité » = suppression).
      // Sans cette règle, la liste ne pouvait JAMAIS être vidée depuis l'app.
      allow update, delete: if isAdmin();
    }

    // ============ DEVOIRS (espace prof) ============
    match /devoirs/{docId} {
      allow read: if true; // les élèves de la classe doivent les voir (cache offline)
      allow write: if isAdmin();
    }
    match /devoir_reponses/{docId} {
      // 🛡️ DURCISSEMENT 2026-10-02 : `create` anonyme ouvert (aucun écran de
      // l'app n'écrit plus cette collection depuis la suppression du service
      // « devoirs » ; seul un ancien APK peut encore le faire).
      allow create: if estAuth() && devoirReponseValide();
      allow read: if isAdmin() || estSoiMeme(resource.data.userId);
    }

    // ============ DEMANDES D'AIDE (mot de passe oublié) ============
    match /demandes_aide/{docId} {
      // ⚠️ Création ANONYME INTENDUE : l'élève qui a perdu son mot de passe
      // ne peut pas se connecter, c'est littéralement l'objet de cette
      // collection. On n'ajoute donc PAS `estAuth()` (on casserait la
      // récupération de compte) — mais on ferme la forme du document :
      // `hasOnly` interdit tout champ supplémentaire (pollution/mass-assignment).
      allow create: if request.resource.data.keys().hasOnly(['nom', 'dateISO'])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 60
        && request.resource.data.dateISO is string
        && request.resource.data.dateISO.size() <= 40;
      allow read: if isAdmin();
      // 🛠️ L'admin voit la demande dans l'app (dashboard) puis la marque
      // « ✔ Traitée ». Avant, l'élève lisait « va voir l'administrateur » mais
      // l'admin n'avait AUCUNE liste dans l'app : il devait ouvrir la console.
      allow update, delete: if isAdmin();
    }

    // ============ CRASH LOGS (rapports de plantage) ============
    match /crash_logs/{docId} {
      // 🛡️ DURCISSEMENT 2026-10-02 : `create` anonyme ouvert → n'importe qui
      // pouvait écrire des milliers de faux rapports de plantage (le vrai
      // rapport arrive via `syncQueue`, toujours avec une session Firebase).
      allow create: if estAuth() && crashLogValide();
      allow read: if isAdmin();
    }

    // ============ CLASSEMENT PUBLIC (données sûres, agrégées) ============
    // Nom, classe, niveau, xp, xp_semaine, avatar UNIQUEMENT — jamais email,
    // hash de mot de passe ni code de transfert.
    //
    // ⚠️ Le projet est sur le plan SPARK : la Cloud Function d'agrégation ne
    // peut pas être déployée. C'est donc le PROPRIÉTAIRE qui publie sa propre
    // fiche depuis l'app (aucune autre écriture possible), avec une liste de
    // champs fermée : même un client modifié ne peut rien y glisser d'autre.
    match /classement_public/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (estSoiMeme(userId) && fichePubliqueValide());
    }

    // ============ CONFIG APP (code superadmin, sentinelle bootstrap) ============
    // 🛡️ BOOTSTRAP SUPERADMIN — avant, `write: if isAdmin()` seul rendait le
    // premier bootstrap IMPOSSIBLE : personne n'est encore admin, donc
    // `config/initialise` (la sentinelle) ne pouvait jamais être écrite depuis
    // l'app. La porte reste strictement à usage unique : UNIQUEMENT si la
    // sentinelle n'existe pas encore, UNIQUEMENT sur ce doc connu, et
    // UNIQUEMENT pour le créer (jamais le modifier ni le supprimer).
    match /config/{docId} {
      // 🔒 `superadmin` est le SEUL document de config fermé en lecture : il
      // peut contenir l'empreinte du code de bootstrap (secret de fait). Le
      // reste (initialise) doit rester lisible AVANT connexion,
      // sinon l'écran de bootstrap ne peut pas amorcer l'app.
      allow read: if docId != 'superadmin' || isAdmin();
      // 🔒 `superadmin` est EXCLU de toute écriture cliente : seul le SDK admin
      // (console Firebase, `tmp/creer_superadmin.js` ou Cloud Function
      // `devenirSuperAdmin`) le pose. Sans
      // cette exclusion, un admin pourrait planter SON PROPRE `codeHash` puis
      // s'auto-promouvoir superadmin — la hiérarchie n'aurait plus aucun sens.
      // 🛡️ DURCISSEMENT 2026-10-02 — DÉNI DE SERVICE FERMÉ : avant, la seule
      // condition pour écrire `config/initialise` était `!adminInitialise()`.
      // Or la sentinelle est LISIBLE AVANT CONNEXION : n'importe qui, SANS
      // COMPTE, pouvait donc la créer et verrouiller DÉFINITIVEMENT le
      // bootstrap de l'établissement (la vraie sentinelle n'aurait plus jamais
      // pu être posée → plus aucun admin possible).
      // Désormais la sentinelle n'est posable que par un compte AUTHENTIFIÉ qui
      // vient d'être inscrit dans `admins/<uid>` par le flux de bootstrap, avec
      // une forme fermée (`par`/`nom`/`le`) et `par == son propre uid`.
      allow create: if docId != 'superadmin'
        && (isAdmin() || (docId == 'initialise' && sentinelleBootstrapValide()));
      allow update, delete: if docId != 'superadmin' && isAdmin();
    }

    // ============ JOURNAL D'AUDIT (admin seul) ============
    match /journal_audit/{docId} {
      allow read, write: if isAdmin();
    }

    // ============ RÔLES ============
    match /roles/{userId} {
      // 📌 docId == uid (même convention que `admins`, exposée par isAdmin()).
      allow read: if isAdmin() || estSoiMeme(userId);
      // Un admin gère les rôles de tout le monde. Le cas `estSoiMeme` couvre
      // le BOOTSTRAP : le premier admin doit pouvoir écrire son propre
      // doc de rôle (une seule fois — voir adminInitialise()).
      // Le superadmin est INTOUCHABLE sauf par lui-meme.
      allow write: if isSuperAdmin()
        || (isAdmin() && !(estCibleSuperAdmin(userId)))
        || (estSoiMeme(userId) && !adminInitialise());
    }

    // ============ ADMINS (liste des admins) ============
    // 📌 CONVENTION : docId == userId. Les règles n'interrogent pas la base
    // (pas de « where ») : elles ne testent que des CHEMINS. Sans cette
    // convention, `exists(admins/$(request.auth.uid))` est impossible et le
    // modèle `admins` devient invérifiable côté serveur — c'était le cas
    // avant, d'où un écran d'administration que PERSONNE ne pouvait ouvrir.
    match /admins/{userId} {
      // 🛡️ DURCISSEMENT 2026-10-02 : `read: if true` publiait la LISTE DES
      // ADMINISTRATEURS (noms compris) à tout client ANONYME, énumérable en
      // boucle via l'API REST. `get` → soi-même (l'app teste son appartenance)
      // ou un admin.
      allow read: if estAuth() && (estSoiMeme(userId) || isAdmin());
      // `list` : requis par le dashboard admin (`getDocs(collection admins)`)
      // et par le contrôle « premier démarrage » du bootstrap — ce dernier
      // n'existe que TANT QUE la sentinelle n'est pas posée.
      allow list: if estAuth() && (isAdmin() || !adminInitialise());
      // create : un admin en place promeut qui il veut.
      allow create: if isAdmin() || (estSoiMeme(userId) && !adminInitialise());
      // update/delete : jamais en auto-promotion (ferme l'usurpation).
      // Le superadmin est INTOUCHABLE sauf par lui-meme.
      allow update, delete: if isSuperAdmin() || (isAdmin() && !(estCibleSuperAdmin(userId)));
    }

    // ============ HELPERS ============
    function estSoiMeme(userId) {
      return estAuth() && request.auth.uid == userId;
    }
    function estAuth() {
      return request.auth != null;
    }

    // ============ 🛡️ VALIDATEURS (durcissement 2026-10-02) ============
    // Principe : toute écriture « élève » exige (1) un compte AUTHENTIFIÉ,
    // (2) une forme de document FERMÉE (`hasOnly` → impossible d'injecter des
    // champs arbitraires, donc pas de pollution ni de contournement du tri),
    // (3) la PROPRIÉTÉ du document (`userId` = uid de l'appelant), et
    // (4) des bornes de taille/valeur.

    // 📣 Signalement d'exercice — écrit directement en ligne par
    // `signalementService.ts` : { exoId, raison, dateISO, userId }.
    // `userId` peut être `null` (signalement déposé hors-ligne en mode invité,
    // envoyé plus tard) : on l'accepte, mais tout AUTRE uid est refusé (on ne
    // peut pas se faire passer pour un camarade).
    function signalementValide() {
      return request.resource.data.keys().hasOnly(['exoId', 'raison', 'dateISO', 'userId'])
        && request.resource.data.exoId is string
        && request.resource.data.exoId.size() > 0
        && request.resource.data.exoId.size() <= 120
        && request.resource.data.raison is string
        && request.resource.data.raison.size() > 0
        && request.resource.data.raison.size() <= 60
        && request.resource.data.dateISO is string
        && request.resource.data.dateISO.size() <= 40
        && (!('userId' in request.resource.data)
            || request.resource.data.userId == null
            || request.resource.data.userId == request.auth.uid);
    }

    // 🚨 Rapport de plantage — écrit par `syncQueue` (jamais directement) :
    // celui-ci AJOUTE `userId` (= uid courant), `createdAt` et `syncedAt`.
    function crashLogValide() {
      return request.resource.data.keys().hasOnly(
          ['message', 'stack', 'userId', 'dateISO', 'createdAt', 'syncedAt']
        )
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.userId == request.auth.uid
        && (!('stack' in request.resource.data)
            || (request.resource.data.stack is string
                && request.resource.data.stack.size() <= 3000));
    }

    // 📝 Réponse à un devoir — seul un ancien APK écrit encore cette
    // collection (service « devoirs » supprimé). On garde la cohérence
    // score ≤ total, la propriété et une liste de champs connue.
    function devoirReponseValide() {
      return request.resource.data.keys().hasOnly(
          ['userId', 'devoirId', 'titre', 'matiere', 'reponses', 'score',
           'total', 'dateISO', 'nom', 'classe']
        )
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.total is number
        && request.resource.data.score >= 0
        && request.resource.data.total > 0
        && request.resource.data.score <= request.resource.data.total;
    }

    // 🔐 Sentinelle `config/initialise` — usage UNIQUE, réservé au compte qui
    // vient d'être inscrit dans `admins/<uid>` (flux de bootstrap de
    // `admin.tsx` : admins → roles → sentinelle). `par` = son propre uid :
    // la sentinelle ne peut pas désigner quelqu'un d'autre.
    function sentinelleBootstrapValide() {
      return estAuth()
        && !adminInitialise()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['par', 'nom', 'le'])
        && request.resource.data.par == request.auth.uid;
    }

    // 🏆 PLAFONDS DU CLASSEMENT PUBLIC (durcissement 2026-10-02).
    // L'XP publiée vient du téléphone (`xpLocal`), et le plan SPARK interdit la
    // Cloud Function d'agrégation : sans plafond, un client modifié envoyait
    // `999999999` et prenait la première place pour toujours.
    // Valeurs défendables, mesurées sur les données réelles du LEX
    // (backup du 22/08/2026 : 5 élèves, maximum 1 350 XP) et sur l'économie du
    // jeu (barème le plus généreux : 50 XP par exercice, donc 100 000 XP =
    // 2 000 exercices au maximum du barème ; le palier Légende 👑 est à 10 000).
    function plafondXpTotal() {
      return 100000;
    }
    function plafondXpSemaine() {
      return 10000;
    }
    function donneesUtilisateurPropres() {
      // 🐞 CORRECTIF CRITIQUE : `request.resource.data` est le document
      // RÉSULTANT, pas le patch. Or les profils créés avant l'audit contiennent
      // ENCORE `mot_de_passe` (données réelles : 2 comptes sur 3). Interdire sa
      // simple PRÉSENCE refusait donc TOUTE mise à jour de ces comptes — la
      // synchronisation d'XP et la réparation du `niveau` échouaient en
      // silence (`permission-denied`), et l'élève disparaissait du classement.
      //
      // On interdit désormais d'INTRODUIRE ou de MODIFIER ces champs : le
      // nettoyage des anciens profils reste possible, jamais leur injection.
      // `resource == null` identifie la création (aucun document existant).
      return (!('mot_de_passe' in request.resource.data)
          || (resource != null && 'mot_de_passe' in resource.data
              && request.resource.data.mot_de_passe == resource.data.mot_de_passe))
        && (!('email' in request.resource.data)
          || (resource != null && 'email' in resource.data
              && request.resource.data.email == resource.data.email))
        && (!('codeTransfert' in request.resource.data)
          || (resource != null && 'codeTransfert' in resource.data
              && request.resource.data.codeTransfert == resource.data.codeTransfert));
    }
    // 🎓 Filtrer le classement repose sur `niveau` : une valeur libre (ex.
    // « admin », « 2nde; », ou une classe de collège inexistante au LEX)
    // fausserait le filtre et permettrait de se rendre invisible.
    // Les valeurs autorisées sont STRICTEMENT celles du lycée.
    function niveauLyceeValide(valeur) {
      return valeur is string && valeur in ['2nde', '1ere', 'terminale'];
    }
    function classeLyceeValide(valeur) {
      // On borne la taille sans imposer un libellé : les profils créés avant
      // le modèle lycée conservent leur texte libre le temps de la migration.
      return valeur is string && valeur.size() <= 30;
    }
    function profilScolaireValide() {
      // Rétro-compatibilité offline-first : les profils ANCIENS (sans champ
      // `niveau`) et les mises à jour partielles d'XP doivent continuer de
      // fonctionner. Seule une valeur PRÉSENTE est contrôlée.
      return (!('niveau' in request.resource.data) || niveauLyceeValide(request.resource.data.niveau))
        && (!('classe' in request.resource.data) || classeLyceeValide(request.resource.data.classe));
    }
    // 🏆 Fiche de classement publiée par l'élève lui-même : liste de champs
    // FERMÉE (hasOnly) + bornes de valeurs. Empêche d'y injecter un email, un
    // hash, ou un XP négatif/absurde pour se placer premier.
    function fichePubliqueValide() {
      return request.resource.data.keys().hasOnly(
          ['nom', 'classe', 'niveau', 'xp', 'xp_semaine', 'avatar', 'maj', 'majISO']
        )
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 60
        && (!('classe' in request.resource.data) || classeLyceeValide(request.resource.data.classe))
        && (!('niveau' in request.resource.data) || niveauLyceeValide(request.resource.data.niveau))
        // 🛡️ DURCISSEMENT 2026-10-02 : bornes HAUTES ajoutées. L'XP publiée
        // est auto-déclarée par le téléphone (plan Spark, pas de Cloud
        // Function) : seul un plafond serveur empêche la prise de tête du
        // classement par un client modifié.
        && (!('xp' in request.resource.data)
            || (request.resource.data.xp is int
                && request.resource.data.xp >= 0
                && request.resource.data.xp <= plafondXpTotal()))
        && (!('xp_semaine' in request.resource.data)
            || (request.resource.data.xp_semaine is int
                && request.resource.data.xp_semaine >= 0
                && request.resource.data.xp_semaine <= plafondXpSemaine()))
        && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 8));
    }
    function isSuperAdmin() {
      // Le superadmin est designe par `roles/<uid>.estSuperAdmin == true`
      // (repli `admins/<uid>.role == 'superadmin'` pour le bootstrap console).
      return estAuth() && ((
        exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.estSuperAdmin == true
      ) || (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin'
      ));
    }
    // Le superadmin passe partout ou l'admin passe (hiérarchie stricte).
    function estCibleSuperAdmin(uid) {
      return (exists(/databases/$(database)/documents/roles/$(uid))
          && get(/databases/$(database)/documents/roles/$(uid)).data.estSuperAdmin == true)
        || (exists(/databases/$(database)/documents/admins/$(uid))
          && get(/databases/$(database)/documents/admins/$(uid)).data.role == 'superadmin');
    }
    function isAdmin() {
      // 🔑 SOURCE DE VÉRITÉ = collection `admins` (celle que lit réellement
      // l'écran 🏛️ admin.tsx), avec docId == uid. Repli sur `roles/{uid}.isAdmin`
      // (ancien modèle) pour ne verrouiller aucun admin déjà provisionné.
      //
      // ⚠️ Avant : `isAdmin()` ne regardait QUE `roles/{uid}.isAdmin`. Or le
      // bootstrap initial n'écrivait que dans `admins` → `isAdmin()` était
      // faux pour tout le monde, y compris pour son auteur, et les règles
      // interdisaient jusqu'à sa propre création (poule et œuf).
      return estAuth() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.isAdmin == true)
      );
    }
    function adminInitialise() {
      // Sentinelle posée par le bootstrap du premier admin : elle verrouille
      // DÉFINITIVEMENT l'auto-promotion. Si un admin légitime existait déjà
      // (migration), le client la pose aussi à sa première visite.
      //
      // 🚀 Recommandation de déploiement : créer le premier admin depuis la
      // console Firebase AVANT de distribuer l'app — la sentinelle existe
      // alors d'office et cette porte n'est jamais ouverte.
      return exists(/databases/$(database)/documents/config/initialise);
    }

    // Défaut : deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
