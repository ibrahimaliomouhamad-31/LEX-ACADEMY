{
  "expo": {
    "name": "LEX ACADEMY",
    "slug": "lex-academy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lex.academy"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.lex.academy"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "lex-academy-10eef"
      },
      "firebaseApiKey": "AIzaSyC3y581S0nHqYfIX4TjvumGKLgpDj1G1dg",
      "firebaseAuthDomain": "lex-academy-10eef.firebaseapp.com",
      "firebaseProjectId": "lex-academy-10eef",
      "firebaseStorageBucket": "lex-academy-10eef.firebasestorage.app",
      "firebaseMessagingSenderId": "512518959635",
      "firebaseAppId": "1:512518959635:web:b2463918d2633a4bea85e6"
    }
  }
}
